[appliance]
name = "storagebox-node-01"
state_dir = "/var/lib/s3-storage-node"
runtime_dir = "/run/s3-storage-node"
health_host = "0.0.0.0"
health_port = 9090
probe_interval_seconds = 5
full_probe_interval_seconds = 60
probe_timeout_seconds = 60
startup_timeout_seconds = 30
shutdown_grace_seconds = 45
recovery_initial_seconds = 5
recovery_max_seconds = 60
recovery_stability_seconds = 15
recovery_probe_interval_seconds = 2
recovery_successes_required = 3
worker_fencing_mode = "namespace"
worker_host_address = "169.254.254.1/30"
worker_address = "169.254.254.2/30"
worker_gateway = "169.254.254.1"
s3_canary_enabled = true

[storage.data]
type = "cifs"
source = "//u123456.your-storagebox.de/backup"
mountpoint = "/run/s3-storage-node/mounts/data"
subdirectory = "seaweedfs"
credentials_file = "/run/secrets/cifs_credentials"
sentinel_id = "replace-with-a-stable-unique-id"
allow_initialize = false
min_free_bytes = 10737418240
io_failure_policy = "soft"
handle_reconnect_policy = "auto"
minimum_smb_dialect = "3.1.1"
multichannel_policy = "disabled"
require_transport_observability = false
mount_options = [
  "vers=3.1.1", "uid=10001", "gid=10001", "forceuid", "forcegid",
  "file_mode=0660", "dir_mode=0770", "noperm", "noserverino",
  "iocharset=utf8", "echo_interval=15", "actimeo=1"
]

# Optional exclusive fallback to the same dataset through SFTP/SSHFS.
[storage.data.failover]
enabled = false
primary_name = "cifs-primary"
primary_priority = 10
failback_policy = "manual"
failure_cooldown_seconds = 60

# Verify every configured route before first use and whenever its transport
# settings, credentials, private key, or known-hosts file changes. Set false
# when an intentionally offline alternate must not block startup. The selected
# serving route is always fully certified regardless of this setting.
verify_all_transports_on_startup = true

# Password authentication. When credentials_file is omitted, this route reuses
# storage.data.credentials_file. Hetzner Storage Box SMB and SSH/SFTP accounts
# can therefore share the existing cifs_credentials secret.
[[storage.data.failover.transports]]
name = "sshfs-password"
type = "sshfs"
priority = 20
source = "u123456@u123456.your-storagebox.de:/home"
auth_mode = "password"
known_hosts_file = "/run/secrets/ssh_known_hosts"
port = 23
mount_options = []

# Key authentication is also supported. Ordinarily configure one SSHFS route.
# [[storage.data.failover.transports]]
# name = "sshfs-key"
# type = "sshfs"
# priority = 30
# source = "u123456@u123456.your-storagebox.de:/home"
# auth_mode = "key"
# identity_file = "/run/secrets/ssh_identity"
# known_hosts_file = "/run/secrets/ssh_known_hosts"
# port = 23
# mount_options = []

[storage.metadata]
type = "path"
mountpoint = "/var/lib/s3-storage-node/metadata"
subdirectory = ""
sentinel_id = "metadata-local-01"
allow_initialize = true
min_free_bytes = 1073741824

[storage.index]
type = "path"
mountpoint = "/var/lib/s3-storage-node/index"
subdirectory = ""
sentinel_id = "index-local-01"
allow_initialize = true
min_free_bytes = 1073741824

[metadata]
backend = "embedded"
target = "metadata"
directory = "filer"

[index]
target = "index"
directory = "volume-indexes"

[seaweed]
volume_directory = "volumes"
all_readonly_wait_seconds = 75
auto_index_repair_enabled = true
index_repair_concurrency = 1
index_repair_timeout_seconds = 3600
master_port = 9333
volume_port = 8080
filer_port = 8888
s3_internal_port = 18333
volume_max = 0
volume_size_limit_mb = 30000
default_replication = "000"
filer_max_mb = 16
data_center = ""
rack = ""
disk_type = ""
encrypt_volume_data = false
# SeaweedFS /status is authoritative for the volume ReadOnly bit. Keep this
# enabled so readiness closes on any read-only volume not explicitly accepted.
volume_health_enabled = true
# Only list volume IDs whose upstream ReadOnly state is intentionally accepted.
# Do not add an ID merely to restore readiness after an integrity warning. If an
# official fix candidate is rejected due to a malformed tail, verify rollback,
# never use -ignoreError, and record the certification reason beside the IDs.
expected_readonly_volume_ids = []
master_extra_args = []
volume_extra_args = []
filer_extra_args = []
s3_extra_args = []

[s3]
host = "0.0.0.0"
port = 8333
domain_name = ""
allowed_origins = "*"
external_url = ""
auth_mode = "static"
access_key_file = "/run/secrets/s3_access_key"
secret_key_file = "/run/secrets/s3_secret_key"
tls_mode = "off"
tls_pem_file = ""

# Aggregate admission budget shared by reads, writes, lists, and metadata calls.
# The shared ceiling prevents mixed traffic from bypassing the storage safety cap.
# Requests above max_active_requests wait in HAProxy until a slot opens. Once the
# bounded queue is full, or a request waits longer than queue_timeout_seconds,
# HAProxy returns a retryable HTTP 503 without marking the storage transport failed.
[s3.admission]
enabled = true
max_active_requests = 32
max_queued_requests = 128
queue_timeout_seconds = 30
