FROM debian:13.6-slim

RUN apt-get update \
    && apt-get install -y --no-install-recommends openssh-server \
    && rm -rf /var/lib/apt/lists/*

COPY tests/chaos/sshd-entrypoint.sh /usr/local/bin/chaos-sshd
RUN chmod 0755 /usr/local/bin/chaos-sshd

EXPOSE 22
ENTRYPOINT ["/usr/local/bin/chaos-sshd"]
